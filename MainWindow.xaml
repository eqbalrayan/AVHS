<Window x:Class="AVMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"

        Title="ASHM"
        Icon="/Resources/medical-symbol.png"
        Height="600"
        Width="1000"

        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"

        Background="#F5F5F5">

    <Border BorderBrush="#D6E0E5"
            BorderThickness="1">

        <Grid>

            <!-- ================= ROW DEFINITIONS ================= -->

            <Grid.RowDefinitions>

                <!-- TITLE BAR -->
                <RowDefinition Height="34"/>

                <!-- MENU -->
                <RowDefinition Height="60"/>

                <!-- CONTENT -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->

            <Border Grid.Row="0"
                    Background="#1565C0">

                <Grid>

                    <!-- TITLE -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">

                        <Image Source="/Resources/medical-symbol.png"
                               Width="22"
                               Height="22"
                               Margin="0,0,8,0"/>

                        <TextBlock Text="ASHTAVINAYAK MULTISPECIALITY HOSPITAL &amp; KARN ADVANCE ORTHO AND TRAUMA CENTRE"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- WINDOW BUTTONS -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <!-- MINIMIZE -->
                        <Button x:Name="BtnMinimize"
                                Content="—"
                                Width="40"
                                Height="34"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="border"
                                            Background="Transparent">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="#1E88E5"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                        <!-- MAXIMIZE -->
                        <Button x:Name="BtnMaximize"
                                Content="☐"
                                Width="40"
                                Height="34"
                                FontSize="12"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="border"
                                            Background="Transparent">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="#1E88E5"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                        <!-- CLOSE -->
                        <Button x:Name="BtnClose"
                                Content="✕"
                                Width="40"
                                Height="34"
                                FontSize="12"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="border"
                                            Background="Transparent">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="#E53935"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>
            <!-- ================= MENU BAR ================= -->

            <Border Grid.Row="1"

        Margin="10,8"
        Background="White"
        CornerRadius="14"
        BorderBrush="#DDE5EA"
        BorderThickness="1">

                <!-- SHADOW -->
                <Border.Effect>

                    <DropShadowEffect BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.15"
                          Color="#000000"/>

                </Border.Effect>


                <Menu Background="Transparent"
          VerticalAlignment="Center"
          Padding="10,4"
          FontFamily="Segoe UI">

                    <!-- ================= RESOURCES ================= -->

                    <Menu.Resources>

                        <!-- ================================================= -->
                        <!-- =============== TOP MENU STYLE ================== -->
                        <!-- ================================================= -->

                        <Style x:Key="TopMenuItemStyle"
                   TargetType="{x:Type MenuItem}">

                            <Setter Property="Foreground"
                        Value="#263238"/>

                            <Setter Property="FontSize"
                        Value="13"/>

                            <Setter Property="FontWeight"
                        Value="SemiBold"/>

                            <Setter Property="Background"
                        Value="Transparent"/>

                            <Setter Property="Padding"
                        Value="18,10"/>

                            <Setter Property="Margin"
                        Value="3,0"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="{x:Type MenuItem}">

                                        <Grid>

                                            <!-- TOP BUTTON -->
                                            <Border x:Name="TopBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                                <Grid>

                                                    <ContentPresenter ContentSource="Header"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>

                                                </Grid>

                                            </Border>

                                            <!-- POPUP -->
                                            <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       HorizontalOffset="0"
                                       VerticalOffset="6"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsSubmenuOpen,
                                       RelativeSource={RelativeSource TemplatedParent}}">

                                                <Border Background="White"
                                            CornerRadius="14"
                                            Padding="8"
                                            BorderBrush="#E3EAF0"
                                            BorderThickness="1"
                                            MinWidth="240">

                                                    <!-- SHADOW -->
                                                    <Border.Effect>

                                                        <DropShadowEffect BlurRadius="24"
                                                              ShadowDepth="3"
                                                              Opacity="0.20"
                                                              Color="#000000"/>

                                                    </Border.Effect>

                                                    <StackPanel IsItemsHost="True"/>

                                                </Border>

                                            </Popup>

                                        </Grid>

                                        <!-- TRIGGERS -->

                                        <ControlTemplate.Triggers>

                                            <!-- HOVER -->
                                            <Trigger Property="IsMouseOver"
                                         Value="True">

                                                <Setter TargetName="TopBorder"
                                            Property="Background"
                                            Value="#E3F2FD"/>

                                                <Setter Property="Foreground"
                                            Value="#1565C0"/>

                                            </Trigger>

                                            <!-- ACTIVE -->
                                            <Trigger Property="IsSubmenuOpen"
                                         Value="True">

                                                <Setter TargetName="TopBorder"
                                            Property="Background"
                                            Value="#BBDEFB"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                        <!-- ================================================= -->
                        <!-- ================= SUB MENU STYLE ================= -->
                        <!-- ================================================= -->

                        <Style x:Key="SubMenuItemStyle"
                   TargetType="{x:Type MenuItem}">

                            <Setter Property="Foreground"
                        Value="#37474F"/>

                            <Setter Property="Background"
                        Value="Transparent"/>

                            <Setter Property="Padding"
                        Value="14,11"/>

                            <Setter Property="Margin"
                        Value="2"/>

                            <Setter Property="FontSize"
                        Value="13"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="{x:Type MenuItem}">

                                        <Grid>

                                            <!-- ITEM -->
                                            <Border x:Name="SubBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                                <Grid Margin="{TemplateBinding Padding}">

                                                    <Grid.ColumnDefinitions>

                                                        <!-- TITLE -->
                                                        <ColumnDefinition Width="*"/>

                                                        <!-- SHORTCUT -->
                                                        <ColumnDefinition Width="Auto"/>

                                                        <!-- ARROW -->
                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>

                                                    <!-- HEADER -->
                                                    <ContentPresenter Grid.Column="0"
                                                          ContentSource="Header"
                                                          VerticalAlignment="Center"/>

                                                    <!-- SHORTCUT -->
                                                    <TextBlock Grid.Column="1"
                                                   Text="{TemplateBinding InputGestureText}"
                                                   Foreground="#90A4AE"
                                                   Margin="20,0,0,0"
                                                   VerticalAlignment="Center"/>

                                                    <!-- ARROW -->
                                                    <TextBlock x:Name="ArrowIcon"
                                                   Grid.Column="2"
                                                   Text="▶"
                                                   FontSize="10"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#78909C"
                                                   Visibility="Collapsed"/>

                                                </Grid>

                                            </Border>

                                            <!-- RIGHT SUBMENU -->
                                            <Popup x:Name="PART_Popup"
                                       Placement="Right"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       HorizontalOffset="-2"
                                       VerticalOffset="0"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsSubmenuOpen,
                                       RelativeSource={RelativeSource TemplatedParent}}">

                                                <Border Background="White"
                                            CornerRadius="14"
                                            Padding="8"
                                            BorderBrush="#E3EAF0"
                                            BorderThickness="1"
                                            MinWidth="240">

                                                    <!-- SHADOW -->
                                                    <Border.Effect>

                                                        <DropShadowEffect BlurRadius="24"
                                                              ShadowDepth="3"
                                                              Opacity="0.20"
                                                              Color="#000000"/>

                                                    </Border.Effect>

                                                    <StackPanel IsItemsHost="True"/>

                                                </Border>

                                            </Popup>

                                        </Grid>

                                        <!-- TRIGGERS -->

                                        <ControlTemplate.Triggers>

                                            <!-- HOVER -->
                                            <Trigger Property="IsMouseOver"
                                         Value="True">

                                                <Setter TargetName="SubBorder"
                                            Property="Background"
                                            Value="#F1F8FE"/>

                                                <Setter Property="Foreground"
                                            Value="#1565C0"/>

                                            </Trigger>

                                            <!-- ARROW -->
                                            <Trigger Property="HasItems"
                                         Value="True">

                                                <Setter TargetName="ArrowIcon"
                                            Property="Visibility"
                                            Value="Visible"/>

                                            </Trigger>

                                            <!-- ACTIVE -->
                                            <Trigger Property="IsSubmenuOpen"
                                         Value="True">

                                                <Setter TargetName="SubBorder"
                                            Property="Background"
                                            Value="#E3F2FD"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </Menu.Resources>


                    <!-- ================================================= -->
                    <!-- =================== MASTER ======================= -->
                    <!-- ================================================= -->

                    <MenuItem Header="Master"
                  Style="{StaticResource TopMenuItemStyle}">

                        <MenuItem Header="Corporate Master"
                      Style="{StaticResource SubMenuItemStyle}"/>

                        <Separator/>

                        <MenuItem Header="Department Master"
                      Style="{StaticResource SubMenuItemStyle}"/>

                        <Separator/>

                        <MenuItem Header="Doctor Master"
                      Style="{StaticResource SubMenuItemStyle}"/>

                    </MenuItem>

                    <!-- ================================================= -->
                    <!-- ================= ADMINISTRATION ================= -->
                    <!-- ================================================= -->

                    <MenuItem Header="Administration"
                  Style="{StaticResource TopMenuItemStyle}">

                        <MenuItem Header="Hospital Setup"
                      Style="{StaticResource SubMenuItemStyle}">

                            <MenuItem Header="Service Group"
                          Style="{StaticResource SubMenuItemStyle}"/>

                            <Separator/>

                            <MenuItem Header="Service Master"
                          Style="{StaticResource SubMenuItemStyle}"/>

                            <Separator/>

                            <MenuItem Header="Service Charge"
                          Style="{StaticResource SubMenuItemStyle}"/>

                        </MenuItem>

                        <Separator/>

                        <MenuItem Header="Tools"
                      Style="{StaticResource SubMenuItemStyle}"/>

                    </MenuItem>

                   


                    <!-- ================================================= -->
                    <!-- ====================== IPD ======================= -->
                    <!-- ================================================= -->

                    <MenuItem Header="IPD"
                  Style="{StaticResource TopMenuItemStyle}">

                        <MenuItem Header="In Patient Registration"
                      Style="{StaticResource SubMenuItemStyle}">

                            <MenuItem Header="Admission"
                          Style="{StaticResource SubMenuItemStyle}"/>

                            <Separator/>

                            <MenuItem Header="Room Shifting"
                          Style="{StaticResource SubMenuItemStyle}"/>

                            <Separator/>

                            <MenuItem Header="Discharge Summary"
                          Style="{StaticResource SubMenuItemStyle}"/>

                        </MenuItem>

                        <Separator/>

                        <MenuItem Header="Modifications"
                      Style="{StaticResource SubMenuItemStyle}"/>

                    </MenuItem>

                    <!-- ================================================= -->
                    <!-- ==================== BILLING ===================== -->
                    <!-- ================================================= -->

                    <MenuItem Header="Billing"
                  Style="{StaticResource TopMenuItemStyle}">

                        <MenuItem Header="OPD Billing"
                      Style="{StaticResource SubMenuItemStyle}"/>

                        <Separator/>

                        <MenuItem Header="IPD Billing"
                      Style="{StaticResource SubMenuItemStyle}"/>

                    </MenuItem>

                    <!-- ================================================= -->
                    <!-- ==================== REPORTS ===================== -->
                    <!-- ================================================= -->

                    <MenuItem Header="Reports"
                  Style="{StaticResource TopMenuItemStyle}">

                        <MenuItem Header="Daily Report"
                      Style="{StaticResource SubMenuItemStyle}"/>

                        <Separator/>

                        <MenuItem Header="Income Report"
                      Style="{StaticResource SubMenuItemStyle}"/>

                    </MenuItem>

                </Menu>

            </Border>

            <!-- ================= CONTENT AREA ================= -->

            <Grid Grid.Row="2"
                  Background="#F5F5F5">

                <!-- BACKGROUND IMAGE -->
                <Image Source="/Resources/bg1.png"
                       Stretch="UniformToFill"
                       Opacity="1"/>

                <!-- OVERLAY -->
                <Border Background="#50FFFFFF"/>

                <!-- CENTER TEXT -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="ASHTAVINAYAK MULTISPECIALITY HOSPITAL"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#263238"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Hospital Management System"
                               FontSize="18"
                               Margin="0,10,0,0"
                               Foreground="#546E7A"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              